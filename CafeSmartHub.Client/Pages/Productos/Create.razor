@page "/productos/nuevo"
@inject CafeSmartHub.Client.Services.ProductosApi Api
@inject CafeSmartHub.Client.Services.CategoriasApi CategoriasApi
@inject NavigationManager Nav

<h3>Nuevo producto</h3>

@if (loading)
{
    <p>Cargando...</p>
}
else
{
    <EditForm Model="model" OnValidSubmit="Save">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <InputText class="form-control" @bind-Value="model.Nombre" />
        </div>

        <div class="mb-3">
            <label class="form-label">Categoría</label>
            <InputSelect class="form-select" @bind-Value="model.CategoriaProductoId">
                <option value="0">-- Selecciona --</option>
                @foreach (var c in categorias)
                {
                    <option value="@c.Id">@c.Nombre</option>
                }
            </InputSelect>
        </div>

        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Precio</label>
                <InputNumber class="form-control" @bind-Value="model.Precio" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Stock actual</label>
                <InputNumber class="form-control" @bind-Value="model.StockActual" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Stock mínimo</label>
                <InputNumber class="form-control" @bind-Value="model.StockMinimo" />
            </div>
        </div>

        <div class="d-flex gap-2 flex-wrap">
            <button class="btn btn-primary" type="submit">Guardar</button>
            <button class="btn btn-secondary" type="button" @onclick="GoBack">Volver</button>
        </div>
    </EditForm>
}

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger mt-3">@error</div>
}

@code {
    private CafeSmartHub.Client.Models.ProductoCreateDto model = new();
    private List<CafeSmartHub.Client.Models.CategoriaReadDto> categorias = new();
    private bool loading = true;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            categorias = (await CategoriasApi.GetAll(activa: true)) ?? new();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task Save()
    {
        error = null;
        try
        {
            await Api.Create(model);
            Nav.NavigateTo("/productos");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private void GoBack() => Nav.NavigateTo("/productos");
}

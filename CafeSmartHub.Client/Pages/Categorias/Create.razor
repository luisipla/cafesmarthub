@page "/categorias/nueva"
@inject CafeSmartHub.Client.Services.CategoriasApi Api
@inject NavigationManager Nav

<h3>Nueva Categoría</h3>

<EditForm Model="model" OnValidSubmit="Save">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <InputText class="form-control" @bind-Value="model.Nombre" />
    </div>

    <div class="form-check mb-3">
        <InputCheckbox class="form-check-input" @bind-Value="model.Activa" />
        <label class="form-check-label">Activa</label>
    </div>

    <div class="d-flex gap-2 flex-wrap">
        <button class="btn btn-primary" type="submit">Guardar</button>
        <button class="btn btn-secondary" type="button" @onclick="GoBack">Volver</button>
    </div>
</EditForm>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger mt-3">@error</div>
}

@code {
    private CafeSmartHub.Client.Models.CategoriaCreateDto model = new();
    private string? error;

    private async Task Save()
    {
        error = null;
        try
        {
            await Api.Create(model);
            Nav.NavigateTo("/categorias");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    private void GoBack() => Nav.NavigateTo("/categorias");
}

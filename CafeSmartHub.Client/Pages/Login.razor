@page "/login"
@using CafeSmartHub.Client.Auth
@inject AuthApi AuthApi
@inject JwtAuthStateProvider AuthState
@inject NavigationManager Nav

<h2>Iniciar sesión</h2>
<p>Ingrese credenciales según perfil.</p>

<div style="max-width:520px;">
    <div class="mb-2">
        <label class="form-label">Usuario</label>
        <input class="form-control" @bind="Username" />
    </div>

    <div class="mb-3">
        <label class="form-label">Contraseña</label>
        <!-- Visible -->
        <input class="form-control" @bind="Password" />
    </div>

    <div class="d-flex gap-2">
        <button class="btn btn-primary" @onclick="DoLogin" disabled="@IsBusy">Entrar</button>
        <button class="btn btn-outline-secondary" @onclick="FillAdmin" disabled="@IsBusy">Admin</button>
        <button class="btn btn-outline-secondary" @onclick="FillUser" disabled="@IsBusy">Usuario</button>
    </div>

    @if (!string.IsNullOrWhiteSpace(Message))
    {
        <div class="mt-3 alert alert-info">@Message</div>
    }

    <div class="mt-3 text-muted">
        Admin: <b>admin/admin</b> | Usuario: <b>user/user</b>
    </div>
</div>

@code {
    private string Username { get; set; } = "";
    private string Password { get; set; } = "";
    private string Message { get; set; } = "";
    private bool IsBusy { get; set; }

    private void FillAdmin()
    {
        Username = "admin";
        Password = "admin";
        Message = "";
    }

    private void FillUser()
    {
        Username = "user";
        Password = "user";
        Message = "";
    }

    private async Task DoLogin()
    {
        IsBusy = true;
        Message = "";

        try
        {
            var res = await AuthApi.LoginAsync(Username, Password);
            if (!res.Ok || string.IsNullOrWhiteSpace(res.Token))
            {
                Message = res.Message;
                return;
            }

            await AuthState.SetTokenAsync(res.Token);
            Nav.NavigateTo("/", forceLoad: false);
        }
        catch
        {
            Message = "Error inesperado al iniciar sesión.";
        }
        finally
        {
            IsBusy = false;
        }
    }
}
